NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/thinkstack
# Separate DB for `npm test` — never point this at your dev database
TEST_MONGODB_URI=mongodb://localhost:27017/thinkstack_test

# JWT — set both secrets in production (JWT_REFRESH_SECRET signs refresh tokens)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Judge0 (RapidAPI or self-hosted). Leave empty for Coming Soon UI. Set JUDGE0_MOCK=true for simulated runs in dev.
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_MOCK=false
CODE_EXEC_RATE_LIMIT_PER_MIN=10

# Google Gemini AI Tutor — https://aistudio.google.com/apikey
# Leave empty for Coming Soon UI. Set GEMINI_MOCK=true only for local simulated responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MOCK=false
AI_RATE_LIMIT_PER_HOUR=20

# Cloudinary (profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email
RESEND_API_KEY=
EMAIL_FROM=ThinkStack <noreply@thinkstack.dev>

# Admin bootstrap (server startup + optional manual seed)
ADMIN_EMAIL=admin@thinkstack.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Auto-seed default content on server startup (set false to disable)
BOOTSTRAP_ON_START=true
