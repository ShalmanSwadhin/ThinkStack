# Dev: use /api/v1 (Vite proxies to backend — required for auth cookies)
# Production: set full API URL, e.g. https://api.yourdomain.com/api/v1
VITE_API_URL=/api/v1
VITE_APP_NAME=ThinkStack

# Cloudinary unsigned upload preset (profile avatars)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=thinkstack_unsigned
