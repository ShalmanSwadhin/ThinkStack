{
  "name": "thinkstack",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Data Structures & Algorithms Learning Platform",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "free-port": "node scripts/free-port.mjs 5000",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "test": "npm run test -w backend",
    "seed": "npm run seed -w backend",
    "seed:fresh": "npm run seed:fresh -w backend",
    "seed:sync": "npm run seed:sync -w backend",
    "smoke": "node scripts/smoke-test.mjs",
    "test:tracing": "node scripts/test-trace-engine.mjs",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
