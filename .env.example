# Environment variables template — copy to backend/.env and frontend/.env

# ============================================
# BACKEND (.env in backend/)
# ============================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thinkstack?retryWrites=true&w=majority

# JWT (required in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Judge0 API (playground + problem grading)
# Set JUDGE0_MOCK=false and add JUDGE0_API_KEY for live execution
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_MOCK=true

# Google Gemini AI Tutor — https://aistudio.google.com/apikey
# Set GEMINI_MOCK=false and add GEMINI_API_KEY for live responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MOCK=true

# Cloudinary (profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email (password reset)
RESEND_API_KEY=
EMAIL_FROM=ThinkStack <noreply@yourdomain.com>

# Admin bootstrap (auto-created on server start)
ADMIN_EMAIL=admin@thinkstack.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Auto-seed default DSA content on every server startup (set false to disable)
BOOTSTRAP_ON_START=true

# Rate Limits
AI_RATE_LIMIT_PER_HOUR=20
CODE_EXEC_RATE_LIMIT_PER_MIN=10

# ============================================
# FRONTEND (.env in frontend/)
# ============================================

VITE_API_URL=/api/v1
VITE_APP_NAME=ThinkStack
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=thinkstack_unsigned
